{
  "hooks": {
    "PreCompact": [
      {
        "matcher": "^(auto|manual)$",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh \"${PLUGIN_ROOT}/scripts/run_hook.sh\"",
            "timeout": 5,
            "statusMessage": "Checking longtask compaction exit",
            "commandWindows": "& (Join-Path $env:PLUGIN_ROOT 'scripts/run_hook.ps1')"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "^compact$",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh \"${PLUGIN_ROOT}/scripts/run_hook.sh\"",
            "timeout": 5,
            "additionalContextLimit": 2500,
            "statusMessage": "Recovering longtask session exit",
            "commandWindows": "& (Join-Path $env:PLUGIN_ROOT 'scripts/run_hook.ps1')"
          }
        ]
      }
    ]
  }
}
