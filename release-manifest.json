{
  "schema_version": 1,
  "package": "longtask",
  "version": "3.0.0",
  "archive_root": "longtask",
  "files": [
    ".gitattributes",
    ".gitignore",
    "AGENTS.md",
    "LICENSE",
    "README.md",
    "SKILL.md",
    "release-manifest.json",
    "专家审查协议.md",
    "文档架构.md"
  ],
  "directories": [
    ".codex-plugin",
    "docs",
    "evals",
    "references",
    "scripts",
    "skills",
    "tests"
  ],
  "exclude_paths": [
    "evals/host_results.json",
    "evals/invocation_results.json",
    "evals/forward_results.json",
    "evals/memory_results.json",
    "docs/tasks",
    "evals/progress_results.json",
    "evals/results",
    "evals/runs",
    "evals/traces",
    "evals/snapshots"
  ],
  "exclude_names": [
    ".DS_Store",
    "__pycache__",
    ".longtask",
    "dist",
    ".artifacts",
    ".pytest_cache",
    ".venv",
    "htmlcov"
  ],
  "exclude_suffixes": [
    ".pyc",
    ".pyo",
    "_results.json",
    ".jsonl"
  ]
}
